# Copier ce fichier en .env et remplir les valeurs

# Base de données PostgreSQL
# IMPORTANT : le driver doit être asynchrone (create_async_engine dans
# database/connexion.py). Un DSN synchrone (postgresql:// ou sqlite://) fait
# échouer le démarrage de l'API avec InvalidRequestError.
#   - PostgreSQL : postgresql+asyncpg://...
#   - SQLite en développement local : sqlite+aiosqlite:///./tomatoscan.db
DATABASE_URL=postgresql+asyncpg://tomatoscan:tomatoscan@localhost:5432/tomatoscan
POSTGRES_DB=tomatoscan
POSTGRES_USER=tomatoscan
POSTGRES_PASSWORD=change_me_in_production

# Clé secrète JWT — générer avec : openssl rand -hex 32
SECRET_KEY=changeme_generer_une_vraie_cle
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Compte administrateur pour POST /auth/token
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme_mot_de_passe_fort

API_HOST=0.0.0.0
API_PORT=8000

# Environnement applicatif
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# CORS — plusieurs origines séparées par des virgules (jamais * en production,
# incompatible avec allow_credentials=True)
CORS_ORIGINS=https://preprod.satoshi-moreau.fr,https://tomatoscan.satoshi-moreau.fr

# Chemin vers le checkpoint MobileNetV2 utilisé par /predict
MODEL_PATH=./models/mobilenetv2_best_20260624_161841.pt

# Chemin vers le CSV d'historique d'entraînement utilisé par /reports
REPORTS_PATH=models/historique_20260624_161841.csv

# Monitoring Grafana — mot de passe de l'interface d'administration
# Accès : http://<host>:3000 (login : admin)
GRAFANA_PASSWORD=change_me_in_production

# URL Grafana affichée par le bouton "Ouvrir le monitoring" du tableau de bord admin (front)
GRAFANA_URL=http://localhost:3000

# SMTP Grafana — nécessaire pour que le point de contact e-mail des alertes
# (monitoring/grafana/provisioning/alerting/contact_points.yml) puisse réellement
# notifier. Sans ces variables, la règle d'alerte se déclenche mais n'envoie rien.
GF_SMTP_ENABLED=false
GF_SMTP_HOST=smtp.example.com:587
GF_SMTP_USER=
GF_SMTP_PASSWORD=
GF_SMTP_FROM_ADDRESS=alertes@tomatoscan.local
GF_SMTP_FROM_NAME=TomatoScan Alertes

# Destinataire des alertes Grafana (utilisé par contact_points.yml)
ALERTES_EMAIL_DESTINATAIRE=admin@example.com

# URL de l'API consommée par le frontend Streamlit.
# En local : http://localhost:8000 — dans la stack Docker : http://api:8000
TOMATOSCAN_API_URL=http://localhost:8000
